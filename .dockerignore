# Dependencies
node_modules
frontend/node_modules

# Build outputs
artifacts
cache
coverage
frontend/.nuxt
frontend/.output
frontend/dist

# Local deployment state / generated files that should be created explicitly before build
# Keep frontend/app/contracts included because the Nuxt build needs exported ABIs and addresses.
deployments/*.json

# Secrets and local env
.env
.env.*
!.env.example

# Git / editor noise
.git
.gitignore
.DS_Store
.idea
.vscode

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
